<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Focus Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="app" data-mode="focus" data-username="<%= username %>">
  <div class="shell">
    <header class="topbar">
      <span class="brand">Focus Tracker</span>
      <nav class="top-nav" aria-label="Pages">
        <a href="#/" data-view="focus" aria-current="page">Focus</a>
        <a href="#/reports" data-view="reports">Reports</a>
      </nav>
      <!-- Small copy of the timer, shown on the Reports page so a running session stays visible -->
      <div class="nav-timer">
        <span class="nav-time">25:00</span>
        <button type="button" class="nav-start" aria-label="Start"><svg viewBox="0 0 24 24" class="nav-icon" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>
      </div>
      <div class="who">
        <span>Hi, <strong><%= username %></strong></span>
        <form method="post" action="/logout"><button class="btn btn-ghost btn-small" type="submit">Log out</button></form>
      </div>
    </header>

    <h1 class="visually-hidden">Focus Tracker</h1>

    <main class="layout">
      <!-- ===== Timer ===== -->
      <section class="timer-device" id="timer" aria-label="Timer">
        <div class="tabs" role="group" aria-label="Timer mode">
          <button class="tab" type="button" data-mode="focus" aria-pressed="true">Focus</button>
          <button class="tab" type="button" data-mode="short" aria-pressed="false">Short break</button>
          <button class="tab" type="button" data-mode="long" aria-pressed="false">Long break</button>
        </div>

        <div class="context">
          <div class="wide">
            <label class="visually-hidden" for="label-input">Working on</label>
            <input id="label-input" type="text" maxlength="60" placeholder="What are you working on?" autocomplete="off">
          </div>
          <div>
            <label class="visually-hidden" for="task-select">Task</label>
            <select id="task-select"><option value="">No task</option></select>
          </div>
          <div>
            <label class="visually-hidden" for="category">Category</label>
            <select id="category">
              <option value="study">Study</option>
              <option value="reading">Reading</option>
              <option value="work">Work</option>
              <option value="journal">Journal</option>
            </select>
          </div>
        </div>

        <div class="screen-panel">
          <button class="focus-mode-btn" id="focus-mode-btn" type="button" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5v2H6v3zm10-5h6v5h-2V6h-4zM6 15v3h3v2H4v-5zm12 0h2v5h-5v-2h3z"/></svg>
            <span>Focus mode</span>
          </button>
          <div class="ring">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle class="ring-track" cx="60" cy="60" r="52"></circle>
              <circle class="ring-ticks" cx="60" cy="60" r="44"></circle>
              <circle class="ring-progress" id="ring-progress" cx="60" cy="60" r="52"></circle>
            </svg>
            <div class="ring-center">
              <span class="status-pill" id="status">Ready to focus</span>
              <p id="time-display" aria-live="off">25:00</p>
              <span class="of-total" id="of-total">of 25:00</span>
            </div>
          </div>

          <div class="rounds">
            <span class="dots" id="round-dots" aria-hidden="true"></span>
            <span id="round-text">Session 1 of 4</span>
          </div>

          <div class="controls">
            <div class="control">
              <button class="round-btn" id="reset-btn" type="button" aria-describedby="reset-label">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V2L7 6l5 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z"/></svg>
              </button>
              <span class="visually-hidden" id="reset-label">Reset</span>
            </div>
            <div class="control">
              <button class="round-btn big" id="start-btn" type="button" aria-describedby="start-label">
                <svg viewBox="0 0 24 24" id="start-icon" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </button>
              <span class="visually-hidden" id="start-label">Start</span>
            </div>
            <div class="control">
              <button class="round-btn" id="skip-btn" type="button" aria-describedby="skip-label">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6v12l8.5-6zM16 6h2v12h-2z"/></svg>
              </button>
              <span class="visually-hidden" id="skip-label">Skip</span>
            </div>
          </div>
          <div class="presets" role="group" aria-label="Pomodoro style"></div>
          <!-- Lofi music while you focus. Tracks are CC0 (public domain), stored in public/audio. -->
          <div class="lofi" id="lofi">
            <button type="button" class="lofi-toggle" id="lofi-toggle" aria-pressed="false">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3z"/></svg>
              <span>Lofi music</span>
            </button>
            <p class="lofi-track" id="lofi-track" aria-live="polite"></p>
            <button type="button" class="lofi-next" id="lofi-next" aria-label="Next track" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6v12l8.5-6zM16 6h2v12h-2z"/></svg>
            </button>
            <input type="range" id="lofi-volume" min="0" max="1" step="0.05" aria-label="Music volume" hidden>
          </div>
          <p id="message" role="status"></p>
        </div>

        <!-- Shown after a focus session ends -->
        <div class="panel" id="complete-panel" hidden>
          <h3>Session complete!</h3>
          <p id="complete-text">Nice work. Take a breather, you earned it.</p>
          <p class="kicker">How focused did you feel?</p>
          <div class="rating" role="group" aria-label="How focused did you feel?">
            <button type="button" data-rating="1"><b>1</b>Scattered</button>
            <button type="button" data-rating="2"><b>2</b>Okay</button>
            <button type="button" data-rating="3"><b>3</b>Good</button>
            <button type="button" data-rating="4"><b>4</b>Great</button>
            <button type="button" data-rating="5"><b>5</b>In flow</button>
          </div>
          <div class="panel-actions">
            <button class="btn btn-primary" id="start-break-btn" type="button">Start break</button>
            <button class="btn btn-ghost" id="skip-break-btn" type="button">Skip break</button>
          </div>
        </div>

        <details class="settings">
          <summary>Timer settings</summary>
          <div class="settings-grid">
            <label>Focus (min)<input type="number" id="set-focus" min="1" max="180"></label>
            <label>Short break (min)<input type="number" id="set-short" min="1" max="60"></label>
            <label>Long break (min)<input type="number" id="set-long" min="1" max="60"></label>
            <label>Long break every<input type="number" id="set-every" min="2" max="8"></label>
            <label class="switch">Play a sound when time is up <input type="checkbox" role="switch" id="set-sound"></label>
            <label class="switch">Notify me when I'm in another tab <input type="checkbox" role="switch" id="set-notify"></label>
            <label class="switch">Start breaks automatically <input type="checkbox" role="switch" id="set-auto"></label>
          </div>
        </details>
      </section>

      <div class="side">
        <!-- ===== Tasks ===== -->
        <section class="card" id="tasks" aria-labelledby="tasks-heading">
          <div class="card-head">
            <h2 id="tasks-heading">Tasks</h2>
            <div class="filter" role="group" aria-label="Show">
              <button type="button" data-filter="open" aria-pressed="true">To do</button>
              <button type="button" data-filter="done" aria-pressed="false">Done</button>
            </div>
          </div>
          <form class="task-form" id="task-form">
            <label class="visually-hidden" for="task-title">New task</label>
            <input id="task-title" type="text" maxlength="100" placeholder="Add a task…" autocomplete="off" required>
            <label class="visually-hidden" for="task-estimate">Focus rounds needed</label>
            <select id="task-estimate">
              <option value="1">1 round</option><option value="2">2 rounds</option><option value="3">3 rounds</option>
              <option value="4">4 rounds</option><option value="6">6 rounds</option><option value="8">8 rounds</option>
            </select>
            <button class="btn btn-dark btn-small" type="submit">Add task</button>
          </form>
          <ul class="list" id="task-list" aria-busy="true"><li class="skeleton skeleton-row"></li><li class="skeleton skeleton-row"></li><li class="skeleton skeleton-row"></li></ul>
        </section>

        <!-- ===== Today (Focus page): what you've done so far today ===== -->
        <section class="card" id="today" aria-labelledby="today-heading">
          <div class="card-head"><h2 id="today-heading">Today</h2></div>
          <div class="big-stats">
            <div><b id="today-minutes"><span class="skeleton skeleton-num"></span></b><span>minutes</span></div>
            <div><b id="today-count"><span class="skeleton skeleton-num"></span></b><span>sessions</span></div>
            <div><b id="streak"><span class="skeleton skeleton-num"></span></b><span>day streak</span></div>
          </div>
          <!-- Last 7 days: a filled dot for each day with at least one session -->
          <div class="streak-row">
            <ol class="week-dots" id="week-dots" aria-label="Days you focused this week"></ol>
            <p class="streak-note" id="streak-note"></p>
          </div>
          <!-- Today on a timeline: each block is a session, placed at the time you did it -->
          <div class="day-timeline" id="day-timeline" hidden>
            <div class="tl-track" id="tl-track"></div>
            <div class="tl-hours" id="tl-hours" aria-hidden="true"></div>
          </div>
          <ul class="today-list" id="today-list" aria-busy="true"><li class="skeleton skeleton-row"></li></ul>
        </section>

        <!-- ===== Study room: focus together with friends (body doubling) ===== -->
        <section class="card" id="room" aria-labelledby="room-heading">
          <div class="card-head">
            <h2 id="room-heading">Study room</h2>
          </div>
          <div id="room-out">
            <p class="room-lead">Focus alongside friends: one of you makes a room, the others join with its code.</p>
            <div class="room-actions">
              <button class="btn btn-dark btn-small" id="room-create" type="button">Make a room</button>
              <form id="room-join-form" class="room-join" novalidate>
                <label class="visually-hidden" for="room-code-input">Room code</label>
                <input id="room-code-input" maxlength="9" placeholder="Code, e.g. K7M2QX" autocomplete="off" autocapitalize="characters" spellcheck="false">
                <button class="btn btn-ghost btn-small" type="submit">Join</button>
              </form>
            </div>
          </div>
          <div id="room-in" hidden>
            <p class="room-code-line">Room <b id="room-code" class="room-code"></b>
              <button class="btn btn-ghost btn-small" id="room-copy" type="button">Copy code</button></p>
            <p class="room-note" id="room-note" role="status" hidden></p>
            <p class="room-lead" id="room-people" aria-live="polite"></p>
            <ul class="room-members" id="room-members"></ul>
            <button class="btn btn-ghost btn-small" id="room-leave" type="button">Leave room</button>
          </div>
          <p class="habit-error" id="room-error" role="alert" hidden></p>
        </section>

        <!-- ===== Habits: daily goals that tick themselves from your sessions ===== -->
        <section class="card" id="habits" aria-labelledby="habits-heading">
          <div class="card-head">
            <h2 id="habits-heading">Habits</h2>
            <button class="btn btn-ghost btn-small" id="habit-new" type="button" aria-expanded="false" aria-controls="habit-form">New habit</button>
          </div>
          <form class="habit-form" id="habit-form" hidden>
            <label class="field-label" for="habit-name">Name</label>
            <input id="habit-name" type="text" maxlength="60" placeholder="e.g. Study every day" autocomplete="off" required>
            <div class="habit-form-row">
              <div>
                <label class="field-label" for="habit-category">Counts</label>
                <select id="habit-category">
                  <option value="study">Study sessions</option>
                  <option value="reading">Reading sessions</option>
                  <option value="work">Work sessions</option>
                  <option value="journal">Journal sessions</option>
                </select>
              </div>
              <div>
                <label class="field-label" for="habit-target">Each day</label>
                <select id="habit-target">
                  <option value="1">1 session</option><option value="2" selected>2 sessions</option><option value="3">3 sessions</option>
                  <option value="4">4 sessions</option><option value="6">6 sessions</option><option value="8">8 sessions</option>
                </select>
              </div>
            </div>
            <p class="habit-hint">It ticks itself: every session you finish in that category counts. No checkbox to remember.</p>
            <p class="habit-error" id="habit-error" role="alert" hidden></p>
            <div class="habit-actions">
              <button class="btn btn-ghost btn-small" id="habit-cancel" type="button">Cancel</button>
              <button class="btn btn-dark btn-small" type="submit">Add habit</button>
            </div>
          </form>
          <ul class="habit-list" id="habit-list" aria-busy="true"><li class="skeleton skeleton-row"></li></ul>
        </section>

        <!-- ===== Insights ===== -->
        <section class="card" id="insights" aria-labelledby="insights-heading">
          <div class="card-head">
            <h2 id="insights-heading">Reports</h2>
            <div class="filter" role="tablist" aria-label="Report range">
              <button type="button" role="tab" data-range="day" aria-selected="false" aria-controls="report-chart">Today</button>
              <button type="button" role="tab" data-range="week" aria-selected="true" aria-controls="report-chart">7 days</button>
              <button type="button" role="tab" data-range="month" aria-selected="false" aria-controls="report-chart">30 days</button>
            </div>
          </div>
          <div class="chart" id="report-chart" role="tabpanel" aria-labelledby="insights-heading">
            <div class="chart-total" id="report-total"><span class="skeleton"></span></div>
            <div class="report-bars" id="report-bars" aria-hidden="true"><span class="skeleton skeleton-chart"></span></div>
          </div>
          <ul class="legend" id="report-legend"></ul>
          <details class="report-table">
            <summary>Show table</summary>
            <table>
              <thead><tr><th scope="col">Day</th><th scope="col">Study</th><th scope="col">Reading</th><th scope="col">Work</th><th scope="col">Journal</th></tr></thead>
              <tbody id="report-rows"></tbody>
            </table>
          </details>
          <p class="insight" id="insight"></p>
          <p class="insight">All time: <b id="all-minutes">…</b> minutes in <b id="all-count">…</b> sessions.</p>
          <details class="log" id="log">
            <summary>Recent sessions</summary>
            <ul class="list" id="session-list" aria-busy="true"><li class="skeleton skeleton-row"></li><li class="skeleton skeleton-row"></li></ul>
            <button class="btn btn-ghost btn-small show-more" id="show-more" type="button" hidden>Show more</button>
          </details>
        </section>

      </div>
    </main>
  </div>

  <nav class="bottom-nav" aria-label="Pages">
    <div class="nav-timer">
      <span class="nav-time">25:00</span>
      <button type="button" class="nav-start" aria-label="Start"><svg viewBox="0 0 24 24" class="nav-icon" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>
    </div>
    <a href="#/" data-view="focus" aria-current="page">Focus</a>
    <a href="#/reports" data-view="reports">Reports</a>
  </nav>

  <div class="toast" id="toast" role="status" hidden>
    <span id="toast-text">Deleted</span>
    <button type="button" id="toast-undo">Undo</button>
  </div>

  <!-- Served by Socket.IO itself; only used by the study room -->
  <script src="/socket.io/socket.io.min.js"></script>
  <script src="/timer.js"></script>
</body>
</html>
